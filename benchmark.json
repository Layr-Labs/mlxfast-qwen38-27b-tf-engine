{
  "schemaVersion": 1,
  "name": "mlxfast-qwen38-27b-tf",
  "trackId": "qwen3.8-27b-tf-mlx-v1",
  "description": "Qwen3.8-27B TensorFold speed track on macOS.",
  "category": "zig",
  "direction": "+",
  "minScoreImprovementBips": 200,
  "editablePaths": [
    "mtp-head.manifest.json",
    "Vendor/TensorFold"
  ],
  "optionalEditablePaths": [
    "mtp-head.manifest.json"
  ],
  "editableSurfaceByteBudget": {
    "maxTotalBytes": 55829628,
    "maxFileBytes": 2500000,
    "maxGrowthBytes": 8388608
  },
  "contractPath": "fixtures/qwen3_8_27b_tf_mlx_v1_track.json",
  "setupCommand": [
    "bash",
    "-c",
    "./tools/fetch-benchd.sh && ./setup.sh"
  ],
  "preSubmitCommand": [
    "bash",
    "-c",
    "./tools/qwen38-27b-tf-measure-and-score.sh --preflight-only"
  ],
  "benchmarkCommand": [
    "bash",
    "-c",
    "MLXFAST_SCORE_PATH=score.json ./tools/qwen38-27b-tf-yukon-run.sh"
  ],
  "runner": {
    "provider": "github-actions",
    "workflow": "benchmark.yml"
  },
  "scoreArtifact": "benchmark-results-<run_id>/score.json",
  "scorePath": "score.json",
  "scoring": {
    "mode": "paired-composite",
    "formula": "composite = prefill_gain^0.25 * decode_gain^0.75",
    "scoredExponents": {
      "prefillGainExponent": 0.25,
      "decodeGainExponent": 0.75
    },
    "scoredBatchSize": 1,
    "kvBackend": "contiguous",
    "pairsPerCohort": 2,
    "minPairsPerCohort": 2,
    "decodeSpeedupFloor": 0.95,
    "prefillSpeedupFloor": 0.95,
    "decodeSpeedupCeiling": 5.0,
    "prefillSpeedupCeiling": 1.5
  },
  "leaderboard": {
    "namespace": "qwen3.8-27b-tf-mlx-v1"
  },
  "staticReviewTrackId": "qwen3.8-27b-tf-mlx-v1"
}
